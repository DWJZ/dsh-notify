{
  "name": "dsh-notify",
  "version": "0.1.0",
  "description": "DeepSeek Harness \u7684 Discord \u901a\u77e5\u4e0e\u5e94\u7b54\u63d2\u4ef6\uff1a\u628a\u5ba1\u6279\u4e0e\u63d0\u95ee\u63a8\u5230 Discord\uff0c\u7528\u6309\u94ae\u3001\u4e0b\u62c9\u83dc\u5355\u548c\u8f93\u5165\u6846\u76f4\u63a5\u4f5c\u7b54\u3002 / DSH notifications and answering over Discord: approvals and questions arrive with buttons, selects, and modals.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DWJZ/dsh-notify.git"
  },
  "homepage": "https://github.com/DWJZ/dsh-notify#readme",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "notify.js",
    "discord.js",
    "gateway.js",
    "components.js",
    "client",
    "cordis.patch.yml",
    "README.md",
    "README.zh.md",
    "LICENSE",
    "config.js",
    "web.js",
    "discord-rest.js"
  ],
  "engines": {
    "node": "^22.19 || >=24"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-api-session-controller",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-workspace"
      ]
    }
  },
  "scripts": {
    "test": "node test/format.spec.mjs && node test/turn-notify.spec.mjs && node test/wiring.spec.mjs && node test/discord.spec.mjs && node test/gateway.spec.mjs && node test/components.spec.mjs && node test/twoway.spec.mjs && node test/annotate.spec.mjs && node test/client.spec.mjs",
    "send:test": "node test/send-once.mjs"
  },
  "peerDependencies": {},
  "devDependencies": {}
}
